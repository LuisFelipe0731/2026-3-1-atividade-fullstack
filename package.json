{
  "name": "diatinf-x",
  "version": "1.0.0",
  "private": true,
  "description": "Replica simplificada do X para a atividade de POS",
  "scripts": {
    "start": "node api/server.js",
    "start:local": "DATABASE_URL=postgresql://diatinf:diatinf@localhost:5432/diatinf_x node api/server.js",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose down",
    "dev": "node --watch api/server.js"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=20"
  }
}